{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fresh-portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "kazuma0129.work/*",
      "zone_name": "kazuma0129.work"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/wp", "/wp/*",
      "/wp-login.php", "/wp-login.php/*",
      "/wp-admin", "/wp-admin/*",
      "/admin", "/admin/*",
      "/index.php", "/index.php/*",
      "/blog", "/blog/*",
      "/1.php", "/1.php/*",
      "/wp-content/plugins/index.php", "/wp-content/plugins/index.php/*",
      "/.env", "/.env/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  }
}
