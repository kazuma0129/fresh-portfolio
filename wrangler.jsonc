{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fresh-portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-03",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "API_QUOTA", "class_name": "ApiQuota" }] },
  "migrations": [{ "tag": "v1_api_quota", "new_sqlite_classes": ["ApiQuota"] }],
  "routes": [
    {
      "pattern": "kazuma0129.work/*",
      "zone_name": "kazuma0129.work"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/mcp", "/api", "/api/*", "/about", "/contact", "/privacy", "/docs", "/docs/mcp", "/developers"]
  }
}
