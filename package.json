{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run src/build.ts",
    "check": "bun test && bun run typecheck && bun run build",
    "deploy": "bun run check && wrangler deploy",
    "dev:cloudflare": "bun run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "serve": "bun run build && wrangler dev --local --port 3000"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/negotiator": "0.6.5",
    "@types/turndown": "5.0.6",
    "linkedom": "0.18.15",
    "turndown": "7.2.5",
    "typescript": "^6.0.3",
    "wrangler": "4.118.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "negotiator": "1.1.0"
  }
}
