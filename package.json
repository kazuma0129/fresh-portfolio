{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run src/build.ts",
    "check": "bun test && bun run typecheck && bun run build",
    "deploy": "bun run check && wrangler deploy",
    "dev:cloudflare": "bun run build && wrangler dev",
    "typecheck": "tsc --noEmit",
    "serve": "bun run src/serve.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "typescript": "^6.0.3",
    "wrangler": "4.118.0"
  }
}
